# npm settings of this repo (tracker A3).
#
# ignore-scripts: "npm ci" / "npm install" never run the install scripts of downloaded packages - the usual way a
# poisoned package runs code on a developer PC. Nothing we use needs one (esbuild and rollup get their programs
# from platform packages). It also skips our own "prepare" script, so switch the git hooks on once: npm run hooks
# "npm run <name>" still works.
ignore-scripts=true

# engine-strict: refuse to install on a Node.js version outside "engines" in package.json.
engine-strict=true
