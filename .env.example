# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.
#
# EmailJS sends the messages of the contact form (https://dashboard.emailjs.com).
# These three values end up in the JavaScript of the site, so they are not passwords - but restrict the
# allowed address of the site in the EmailJS dashboard, or anyone can send mail with them.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# The address of the site once it is online, without a closing slash, e.g. https://example.com
# The build needs it for sitemap.xml, the canonical links and the picture of link previews. Empty is fine on a PC.
VITE_SITE_URL=
