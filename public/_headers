# Headers for every file of the site. Read by Cloudflare Pages and Netlify; other hosts ignore this file
# (docs/deploy.md, section 4). vercel.json gives Vercel, the host of the live site, the same headers; a test
# (tools/dev/vercel.test.cjs) keeps the two in step.

/*
  # The browser must not guess the type of a file.
  X-Content-Type-Options: nosniff
  # Nobody may show this site inside a frame of theirs.
  X-Frame-Options: DENY
  # Other sites learn only that a visitor came from here, not from which page.
  Referrer-Policy: strict-origin-when-cross-origin
  # The site uses none of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # What a page may load and run (tracker B11): files of the site itself, and the one inline script of index.html,
  # which sets the theme before the first paint, by its hash (a test gives the new hash when the script changes).
  # Style attributes stay allowed, <style> blocks do not. Connections go to the site and to EmailJS (the contact form).
  # No plugins, no <base>, forms only to the site, and no other site may show a page of this one in a frame.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-hj/ji97ffByQ3vx1BXx7zAWhI0HSvK9yZThD51ERm8s='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.emailjs.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# The names of these files change whenever their content does, so a browser may keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The screenshots keep their names when they are replaced, but every page names them with a fingerprint of their
# files ("?v=1a2b3c4d", tracker F54), which changes with them: a browser may keep them for a year too.
/images/*
  Cache-Control: public, max-age=31536000, immutable
